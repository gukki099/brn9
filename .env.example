# Postgres connection string from Supabase:
# Project Settings → Database → Connection string (URI)
# Prefer the Session pooler (port 5432) or Transaction pooler (port 6543).
# This app sets asyncpg statement_cache_size=0 so PgBouncer transaction mode works.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Optional. SSL is auto-enabled for *.supabase.co URLs.
# DATABASE_SSL=require

# Local only. Render injects PORT automatically.
PORT=8000
